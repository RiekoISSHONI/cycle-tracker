# Telemetry endpoint — anonymous event collection
# Leave blank to disable server-side telemetry (all data stays local)
VITE_TELEMETRY_URL=

# Stripe Payment Links — create these in the Stripe Dashboard
# Leave blank to use client-side demo mode (no real payments)
VITE_STRIPE_LINK_MONTHLY=
VITE_STRIPE_LINK_ANNUAL=
